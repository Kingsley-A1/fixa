# CockroachDB connection string (sslmode=verify-full recommended)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:26257/fixa?sslmode=verify-full"
# Long random value, minimum 32 characters
AUTH_SECRET="replace-with-a-secure-random-secret-at-least-32-characters"
# Public canonical URL of this deployment (e.g. https://fixa.example.com)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Keep disabled until the release-readiness requirements in README.md are met.
ENABLE_REGISTRATION="false"

# Private by default: public technician search and reviews are disabled until the trust launch gate passes.
ENABLE_DISCOVERY="false"

# Google identity (server-only): authorized callback https://fixa.bespoketech.com.ng/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Transactional email only; verify sender in Resend before enabling
RESEND_API_KEY=""
FIXA_EMAIL_FROM=""
# Private Vercel Blob store: provision via Vercel Storage. Keep secret.
BLOB_READ_WRITE_TOKEN=""
# Optional portfolio; keep off until migrations + moderation controls are accepted.
ENABLE_PORTFOLIO="false"
