{
  "name": "fixa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && npm run test:unit && next build",
    "start": "next start",
    "lint": "eslint .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:unit": "node --experimental-strip-types --test tests/repair-search.test.mjs",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "bcryptjs": "^2.4.3",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.6",
    "prisma": "6.19.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "^1.64.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.6",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "effect": "^3.20.0",
    "deepmerge-ts": "^8.0.0"
  }
}
