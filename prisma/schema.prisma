generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "cockroachdb"
  url      = env("DATABASE_URL")
}

enum JobStatus {
  RECEIVED
  DIAGNOSING
  AWAITING_APPROVAL
  IN_PROGRESS
  READY
  COLLECTED
  CANCELLED
}

enum ListingStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  REJECTED
}

enum MemberRole {
  OWNER
  ADMIN
  TECHNICIAN
}

model Business {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  slug      String       @unique
  phone     String?
  createdAt DateTime     @default(now())
  members   Membership[]
  customers Customer[]
  devices   Device[]
  jobs      RepairJob[]
  profiles  TechnicianProfile[]
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  name         String
  email        String       @unique
  passwordHash String
  createdAt    DateTime     @default(now())
  memberships  Membership[]
  profiles TechnicianProfile[]
  platformAdmin PlatformAdmin?
  moderationActions ModerationAction[]
}

model Membership {
  id         String     @id @default(uuid()) @db.Uuid
  businessId String     @db.Uuid
  userId     String     @db.Uuid
  role       MemberRole @default(TECHNICIAN)
  business   Business   @relation(fields: [businessId], references: [id])
  user       User       @relation(fields: [userId], references: [id])

  @@unique([businessId, userId])
  @@index([userId])
}

model Customer {
  id         String      @id @default(uuid()) @db.Uuid
  businessId String      @db.Uuid
  name       String
  phone      String
  whatsapp   String?
  email      String?
  createdAt  DateTime    @default(now())
  business   Business    @relation(fields: [businessId], references: [id])
  devices    Device[]
  jobs       RepairJob[]

  @@index([businessId, phone])
  @@index([businessId, name])
}

model Device {
  id           String      @id @default(uuid()) @db.Uuid
  businessId   String      @db.Uuid
  customerId   String      @db.Uuid
  code         String      @unique
  brand        String
  model        String
  modelNumber  String?
  category     String      @default("Phone")
  serialNumber String?
  imei         String?
  color        String?
  notes        String?
  createdAt    DateTime    @default(now())
  business     Business    @relation(fields: [businessId], references: [id])
  customer     Customer    @relation(fields: [customerId], references: [id])
  jobs         RepairJob[]

  @@index([businessId, serialNumber])
  @@index([businessId, imei])
  @@index([businessId, customerId])
}

model RepairJob {
  id             String     @id @default(uuid()) @db.Uuid
  businessId     String     @db.Uuid
  customerId     String     @db.Uuid
  deviceId       String     @db.Uuid
  code           String     @unique
  publicToken    String     @unique @default(uuid()) @db.Uuid
  issue          String
  condition      String?
  accessories    String?
  diagnosis      String?
  status         JobStatus  @default(RECEIVED)
  estimatedPrice Decimal?   @db.Decimal(15, 2)
  deposit        Decimal?   @db.Decimal(15, 2)
  dueDate        DateTime?
  completedAt    DateTime?
  collectedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  business       Business   @relation(fields: [businessId], references: [id])
  customer       Customer   @relation(fields: [customerId], references: [id])
  device         Device     @relation(fields: [deviceId], references: [id])
  events         JobEvent[]
  assignedProfileId String? @db.Uuid
  assignedProfile TechnicianProfile? @relation(fields: [assignedProfileId], references: [id])
  reviewInvitation ReviewInvitation?
  review TechnicianReview?

  @@index([businessId, status, createdAt])
  @@index([businessId, customerId])
}

model JobEvent {
  id          String     @id @default(uuid()) @db.Uuid
  jobId       String     @db.Uuid
  fromStatus  JobStatus?
  toStatus    JobStatus
  note        String?
  changedById String     @db.Uuid
  createdAt   DateTime   @default(now())
  job         RepairJob  @relation(fields: [jobId], references: [id])

  @@index([jobId, createdAt])
}

/** Each profile is an independent, permissioned identity proposal. */
model TechnicianProfile {
  id String @id @default(uuid()) @db.Uuid
  businessId String @db.Uuid
  ownerUserId String @db.Uuid
  slug String @unique
  displayName String
  headline String?
  bio String?
  publicPhone String
  photoUrl String?
  state String
  city String
  area String?
  specialties String[]
  deviceClasses String[]
  status ListingStatus @default(DRAFT)
  contactVerifiedAt DateTime?
  locationVerifiedAt DateTime?
  identityVerifiedAt DateTime?
  approvedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields:[businessId],references:[id])
  owner User @relation(fields:[ownerUserId],references:[id])
  jobs RepairJob[]
  reviews TechnicianReview[]
  invitations ReviewInvitation[]
  @@unique([businessId,ownerUserId])
  @@index([status,state,city])
  @@index([businessId,status])
}

model PlatformAdmin {
  userId String @id @db.Uuid
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id])
}

model ModerationAction {
  id String @id @default(uuid()) @db.Uuid
  actorUserId String @db.Uuid
  targetType String
  targetId String
  decision String
  reason String
  createdAt DateTime @default(now())
  actor User @relation(fields:[actorUserId],references:[id])
  @@index([targetType,targetId,createdAt])
}

model ReviewInvitation {
  id String @id @default(uuid()) @db.Uuid
  token String @unique @default(uuid()) @db.Uuid
  jobId String @unique @db.Uuid
  profileId String @db.Uuid
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  job RepairJob @relation(fields:[jobId],references:[id])
  profile TechnicianProfile @relation(fields:[profileId],references:[id])
}

model TechnicianReview {
  id String @id @default(uuid()) @db.Uuid
  jobId String @unique @db.Uuid
  profileId String @db.Uuid
  rating Int
  comment String
  status ReviewStatus @default(PENDING)
  createdAt DateTime @default(now())
  publishedAt DateTime?
  job RepairJob @relation(fields:[jobId],references:[id])
  profile TechnicianProfile @relation(fields:[profileId],references:[id])
  @@index([profileId,status,createdAt])
}
